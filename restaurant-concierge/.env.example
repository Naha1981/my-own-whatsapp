# Server
PORT=3002
LOG_LEVEL=info
NODE_ENV=production

# Postgres — reuse the SAME database as the WhatsApp Operator. The concierge
# only creates tables prefixed rc_ and never touches wa_* tables.
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_operator

# Shared webhook secret — MUST equal the Operator's WEBHOOK_SECRET so inbound
# event signatures verify.
WEBHOOK_SECRET=same-value-as-operator

# Bearer/X-API-Key the AI agent (Instinct) uses to poll the inbox and post replies.
# Generate with: openssl rand -hex 32
CONCIERGE_API_KEY=change-me-to-a-long-random-value

# Operator connection (for sending replies back out)
OPERATOR_BASE_URL=https://my-own-whatsapp-2z5h.onrender.com
OPERATOR_API_KEY=same-value-as-operator

# Public base URL of THIS service — used to register webhooks and printed in
# notification emails so the agent knows where to reply.
CONCIERGE_PUBLIC_URL=https://nahalabs-restaurant-concierge.onrender.com

# Notifications — "resend" emails every inbound customer message to the owner,
# "none" disables email (agent relies on polling alone).
NOTIFIER=none
RESEND_API_KEY=
NOTIFY_FROM=NahaLabs Concierge <onboarding@resend.dev>
NOTIFY_TO=
