# Server
PORT=3001
LOG_LEVEL=info
NODE_ENV=production

# Postgres — session credentials, accounts, bindings, and MCP OAuth state all live here
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_operator

# Shared secret used to sign/verify webhook payloads sent to every "Brain" app.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-value

# Bearer token every Brain app must send to call this Operator's API
# (create account, get QR, send message). Generate with: openssl rand -hex 32
OPERATOR_API_KEY=change-me-to-a-long-random-value

# New secure tenant credential mode.
# Product backends use this credential instead of the platform OPERATOR_API_KEY.
# The plaintext tenant token is issued by POST /accounts/tenant-token and is
# never stored in PostgreSQL; only its SHA-256 hash is stored.
# Header: X-NahaLabs-Tenant-Token
#
# Keep this true only while existing integrations still use the old
# OPERATOR_API_KEY + X-App-Id + X-Tenant-Id flow. Set false after migration.
ALLOW_LEGACY_TENANT_HEADERS=false

# Remote MCP — lets Claude / ChatGPT connect to this Operator over HTTPS.
MCP_ENABLED=true
MCP_PUBLIC_URL=https://my-own-whatsapp-2z5h.onrender.com
MCP_OAUTH_USERNAME=admin
# Generate a long random secret, e.g. openssl rand -hex 32
MCP_OAUTH_PASSWORD=change-me-to-a-different-long-random-value
# MCP access is scoped to this central app/tenant binding.
MCP_APP_ID=nahalabs
MCP_TENANT_ID=default
