# Server
PORT=3001
LOG_LEVEL=info
NODE_ENV=production

# Postgres — session credentials, accounts, and bindings all live here
DATABASE_URL=postgresql://user:password@host:5432/whatsapp_operator

# Shared secret used to sign/verify webhook payloads sent to every "Brain" app.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-value

# Bearer token every Brain app must send to call this Operator's API
# (create account, get QR, send message). Generate with: openssl rand -hex 32
OPERATOR_API_KEY=change-me-to-a-long-random-value
