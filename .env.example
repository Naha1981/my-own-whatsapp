# ============================================================================
# NahaLabs Core App — environment template for ANY app that uses the shared
# WhatsApp Operator deployed from this repo. Copy to .env.local per app.
# All three OPERATOR_* / WEBHOOK_SECRET values must match the Operator exactly.
# ============================================================================

# Point every app at the SAME deployed Operator.
OPERATOR_URL=https://nahalabs-whatsapp-operator.onrender.com
# Provisioning only — do NOT expose this value to browsers or tenant users.
# Existing apps can keep this temporarily while they migrate.
OPERATOR_API_KEY=paste-the-platform-key-only-for-server-side-provisioning

# Tenant runtime credential. Issue with POST /accounts/tenant-token and store
# server-side for this app + tenant.
OPERATOR_TENANT_TOKEN=paste-the-tenant-token

# Used to verify signed inbound webhooks from the Operator.
WEBHOOK_SECRET=paste-the-same-value-you-set-on-the-operator

NEXT_PUBLIC_APP_ID=your-app-slug          # e.g. "leadmachine", "flavourly"
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
